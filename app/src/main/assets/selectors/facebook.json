{
  "version": 2,
  "site": "facebook",
  "displayName": "Facebook",
  "domain": ".facebook.com",
  "sessionName": "facebook",
  "loginCookies": [
    "c_user",
    "xs"
  ],
  "readableLoginCookies": [
    "c_user"
  ],
  "urls": {
    "home": "https://www.facebook.com/",
    "login": "https://www.facebook.com/login",
    "compose": "https://www.facebook.com/",
    "timeline": "https://www.facebook.com/",
    "profile": "https://www.facebook.com/{handle}",
    "search": "https://www.facebook.com/search/posts/?q={query}",
    "recent": "https://www.facebook.com/?sk=h_chr",
    "mobileHome": "https://m.facebook.com/"
  },
  "sessionExpiredUrlPatterns": [
    "/login",
    "/checkpoint",
    "/recover"
  ],
  "selectors": {
    "loggedIn": "[aria-label=\"Your profile\"], [aria-label=\"Account controls and settings\"], [aria-label=\"Account Controls and Settings\"], [aria-label=\"Create a post\"]",
    "loginForm": "form#login_form, input[name=\"email\"][type=\"text\"], input[name=\"pass\"], [data-testid=\"royal_login_form\"]",
    "loginUsername": "input[name=\"email\"]",
    "loginPassword": "input[name=\"pass\"]",
    "loginChallenge": "input[name=\"approvals_code\"], input#approvals_code",
    "composeOpen": "[aria-label=\"Create a post\"] div[role=\"button\"]",
    "composeText": "div[role=\"dialog\"] div[contenteditable=\"true\"][role=\"textbox\"], div[role=\"dialog\"] [contenteditable=\"true\"][aria-label*=\"on your mind\"], div[role=\"dialog\"] [contenteditable=\"true\"][aria-label*=\"Quoi de neuf\"], div[role=\"dialog\"] [contenteditable=\"true\"][aria-label*=\"Exprimez-vous\"], textarea[name=\"xc_message\"]",
    "composeSubmit": "div[role=\"dialog\"] div[aria-label=\"Post\"][role=\"button\"], div[role=\"dialog\"] div[aria-label=\"Publier\"][role=\"button\"]",
    "composeDialogButtons": "[role=\"dialog\"] [role=\"button\"], [role=\"dialog\"] button, form button, form [role=\"button\"]",
    "postSuccess": "[data-farrow-never-matches]"
  },
  "scrape": {
    "item": "div[role=\"article\"][aria-posinset], div[aria-posinset], div[role=\"article\"]",
    "fields": {
      "author": "h2, h3, strong",
      "text": "div[data-ad-preview=\"message\"], div[data-ad-comet-preview=\"message\"]",
      "url": "a[href*=\"/posts/\"], a[href*=\"story_fbid\"], a[href*=\"/permalink/\"]@href",
      "all_text": ""
    },
    "dedupeField": "url"
  },
  "postSteps": [
    {
      "action": "goto",
      "url": "compose",
      "timeoutMs": 45000,
      "label": "open the Facebook home page"
    },
    {
      "action": "clickText",
      "match": "^(Allow all cookies|Autoriser tous les cookies|Decline optional cookies|Refuser les cookies optionnels|Only allow essential cookies|Autoriser uniquement les cookies essentiels)$",
      "optional": true,
      "timeoutMs": 3000,
      "label": "dismiss the cookie banner"
    },
    {
      "action": "clickText",
      "match": "^(Not now|Plus tard|Pas maintenant|Pas pour l.instant)$",
      "optional": true,
      "timeoutMs": 1500,
      "label": "dismiss a 'Not now' popup"
    },
    {
      "action": "clickText",
      "match": "^(What.s on your mind|Create (a )?post|Quoi de neuf|Exprimez-vous|Créer une publication)",
      "scope": "[role=\"button\"], button, a",
      "sturdy": true,
      "dismiss": "^(Allow all cookies|Autoriser tous les cookies|Decline optional cookies|Refuser les cookies optionnels|Only allow essential cookies|Autoriser uniquement les cookies essentiels|Not now|Plus tard|Pas maintenant|Pas pour l.instant)$",
      "fallbackUrls": [
        "recent",
        "mobileHome"
      ],
      "timeoutMs": 45000,
      "label": "open the composer ('What's on your mind' / 'Quoi de neuf')",
      "hint": "Facebook didn't show the 'What's on your mind' box; it may be showing a dialog — see the step log"
    },
    {
      "action": "waitFor",
      "selector": "composeText",
      "dismiss": "^(Not now|Plus tard|Pas maintenant|Pas pour l.instant)$",
      "timeoutMs": 45000,
      "label": "wait for the post editor in the dialog",
      "hint": "The 'Create post' dialog did not open"
    },
    {
      "action": "click",
      "selector": "composeText",
      "timeoutMs": 45000,
      "label": "focus the post editor"
    },
    {
      "action": "typeEditor",
      "selector": "composeText",
      "text": "{text}",
      "timeoutMs": 45000,
      "label": "type the post text"
    },
    {
      "action": "sleep",
      "ms": 1000
    },
    {
      "action": "clickText",
      "match": "^(Next|Suivant)$",
      "scope": "composeDialogButtons",
      "optional": true,
      "timeoutMs": 2000,
      "label": "click Next (multi-step composer)"
    },
    {
      "action": "clickText",
      "match": "^(Post|Publier|Publish)$",
      "scope": "composeDialogButtons",
      "sturdy": true,
      "fallbackKey": "ctrl+Return",
      "timeoutMs": 45000,
      "label": "click Post / Publier"
    },
    {
      "action": "waitPosted",
      "selectors": [
        "composeText"
      ],
      "text": "{text}",
      "timeoutMs": 45000,
      "label": "confirm the post (dialog closed or text in the feed)"
    }
  ],
  "loginSteps": [
    {
      "action": "goto",
      "url": "login"
    },
    {
      "action": "waitFor",
      "selector": "loginUsername",
      "timeoutMs": 25000
    },
    {
      "action": "type",
      "selector": "loginUsername",
      "text": "{username}"
    },
    {
      "action": "type",
      "selector": "loginPassword",
      "text": "{password}",
      "submit": true
    },
    {
      "action": "sleep",
      "ms": 5000
    },
    {
      "action": "type",
      "selector": "loginChallenge",
      "text": "{code}",
      "submit": true,
      "optional": true
    },
    {
      "action": "waitFor",
      "selector": "loggedIn",
      "timeoutMs": 25000
    }
  ]
}
